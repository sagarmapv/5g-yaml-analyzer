    "N3": { "endpoints": ["RAN", "UPF"], "protocol": "GTP-U", "refSpec": "29.281" },
    "N4": { "endpoints": ["SMF", "UPF"], "protocol": "PFCP", "refSpec": "29.244" },
    "N6": { "endpoints": ["UPF", "DN"], "protocol": "user traffic", "refSpec": "23.501" },
